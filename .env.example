# Secrets only. Copy to .env and fill in. Never commit .env.
# Non-secret settings live in config/*.yaml, which names these variables.

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only if the local model server requires a token.
LOCAL_LLM_API_KEY=
# Only for gated model downloads.
HF_TOKEN=

# --- ClickHouse (passwords for the two local users; choose strong values) ---
CLICKHOUSE_WRITER_PASSWORD=
CLICKHOUSE_READONLY_PASSWORD=

# --- PostgreSQL (local Supabase database) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
